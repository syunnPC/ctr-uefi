diff --git a/BaseTools/Source/C/GenFw/ElfConvert.c b/BaseTools/Source/C/GenFw/ElfConvert.c
--- a/BaseTools/Source/C/GenFw/ElfConvert.c
+++ b/BaseTools/Source/C/GenFw/ElfConvert.c
@@ -61,6 +61,24 @@
 //*****************************************************************************
 //
 
+// Keep machine-specific directory names out of the CodeView record.
+CONST CHAR8 *
+GetElfDebugFileName (
+  VOID
+  )
+{
+  CONST CHAR8 *Path;
+  CONST CHAR8 *Name;
+
+  Name = mInImageName;
+  for (Path = mInImageName; *Path != '\0'; Path++) {
+    if (*Path == '/' || *Path == '\\') {
+      Name = Path + 1;
+    }
+  }
+  return Name;
+}
+
 VOID
 CoffAddFixupEntry(
   UINT16 Val
